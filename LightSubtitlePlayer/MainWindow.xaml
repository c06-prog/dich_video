<Window x:Class="LightSubtitlePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightSubtitle Studio Pro" Height="800" Width="1260"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- THANH MENU TRÊN CÙNG -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="#CCCCCC" Padding="4,2">
            <MenuItem Header="Tệp" Foreground="#CCCCCC">
                <MenuItem Header="Mở Video..." Click="BtnOpenVideo_Click"/>
                <MenuItem Header="🎬 Xuất Video MP4 (Ghép Phụ Đề + Giọng AI)..." Click="BtnExportVideo_Click"/>
                <Separator/>
                <MenuItem Header="Thoát" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Phụ đề" Foreground="#CCCCCC">
                <MenuItem Header="Ẩn / Hiện Phụ Đề Trên Video" Click="MenuToggleSubtitle_Click"/>
                <Separator/>
                <MenuItem Header="Sao chép Prompt Chuẩn Rạp + Lồng Tiếng AI" Click="BtnCopyPrompt_Click"/>
                <MenuItem Header="Cấy Thủy Vân Ẩn" Click="BtnInjectStego_Click"/>
                <MenuItem Header="Soát Mã Ẩn" Click="BtnVerifyStego_Click"/>
            </MenuItem>
            <MenuItem Header="Công cụ" Foreground="#CCCCCC">
                <MenuItem Header="Bật/Tắt Vùng Che Mờ" Click="ToggleBlurBox_Click"/>
                <MenuItem Header="Tạo Giọng Đọc AI Ngay" Click="BtnGenerateVoice_Click"/>
            </MenuItem>
        </Menu>

        <!-- KHU VỰC LÀM VIỆC CHÍNH -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="395"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: VIDEO & KHUNG CANVAS TƯƠNG TÁC -->
            <Grid Grid.Column="0" Background="#0C0C0C">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Canvas x:Name="OverlayCanvas" Grid.Row="0" ClipToBounds="True" Background="#000000" SizeChanged="OverlayCanvas_SizeChanged">
                    <!-- Trình phát video chính -->
                    <MediaElement x:Name="VideoPlayer" 
                                  Width="{Binding ActualWidth, ElementName=OverlayCanvas}"
                                  Height="{Binding ActualHeight, ElementName=OverlayCanvas}"
                                  Stretch="Uniform"
                                  LoadedBehavior="Manual" 
                                  UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True" 
                                  MouseLeftButtonUp="VideoPlayer_MouseLeftButtonUp"/>

                    <!-- Trình phát âm thanh lồng tiếng AI (Ẩn) -->
                    <MediaElement x:Name="TtsAudioPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Visibility="Collapsed"
                                  MediaEnded="TtsAudioPlayer_MediaEnded"/>

                    <!-- Đường kẻ căn tâm đứt nét -->
                    <Line x:Name="GuideLineHorizontal" Stroke="#007ACC" StrokeDashArray="4 2" StrokeThickness="1.5" Visibility="Collapsed"/>
                    <Line x:Name="GuideLineVertical" Stroke="#007ACC" StrokeDashArray="4 2" StrokeThickness="1.5" Visibility="Collapsed"/>

                    <!-- HỘP CHE MỜ: Không có viền vàng, chỉ mờ thuần túy, kéo thả tự do -->
                    <Border x:Name="BlurBox" Width="160" Height="100" Canvas.Left="60" Canvas.Top="60"
                            BorderThickness="0" CornerRadius="6"
                            MouseLeftButtonDown="BlurBox_MouseLeftButtonDown"
                            MouseMove="BlurBox_MouseMove"
                            MouseLeftButtonUp="BlurBox_MouseLeftButtonUp"
                            Cursor="SizeAll" Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="#88555555"/>
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="35" KernelType="Gaussian"/>
                        </Border.Effect>
                    </Border>

                    <!-- Watermark bản quyền -->
                    <TextBlock x:Name="TxtWatermark" Text="© Vietsub bởi Nguyễn Cường" 
                               Foreground="#FFFFFF" Opacity="0.5" FontSize="14" FontWeight="SemiBold"
                               Canvas.Right="20" Canvas.Top="20">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Credit người dịch -->
                    <Border x:Name="CreditContainer" Background="#80000000" BorderThickness="0"
                            CornerRadius="4" Padding="8,4" Canvas.Left="100" Canvas.Top="60"
                            MouseLeftButtonDown="DraggableBox_MouseLeftButtonDown"
                            MouseMove="DraggableBox_MouseMove"
                            MouseLeftButtonUp="DraggableBox_MouseLeftButtonUp"
                            Cursor="SizeAll" Visibility="Collapsed">
                        <TextBlock x:Name="TxtCreditContent" Text="Vietsub bởi Nguyễn Cường - Bản quyền video thuộc về kênh Enigma" 
                                   Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" 
                                   TextAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="315" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>

                    <!-- Miễn trừ trách nhiệm -->
                    <Border x:Name="DisclaimerContainer" Background="#80000000" BorderThickness="0"
                            CornerRadius="4" Padding="8,4" MaxWidth="680" Canvas.Left="100" Canvas.Top="15"
                            MouseLeftButtonDown="DraggableBox_MouseLeftButtonDown"
                            MouseMove="DraggableBox_MouseMove"
                            MouseLeftButtonUp="DraggableBox_MouseLeftButtonUp"
                            Cursor="SizeAll" Visibility="Collapsed">
                        <TextBlock x:Name="TxtDisclaimerContent" 
                                   Text="Tất cả quyền hình ảnh và âm thanh thuộc về tác giả gốc. Bản dịch tiếng Việt được thực hiện nhằm mục đích học tập/chia sẻ thông tin kiến thức."
                                   Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="315" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>

                    <!-- PHỤ ĐỀ TRONG VIDEO -->
                    <Border x:Name="SubtitleBox"
                            Background="#80000000" BorderThickness="0" CornerRadius="4" Padding="8,4"
                            MouseLeftButtonDown="DraggableBox_MouseLeftButtonDown"
                            MouseMove="DraggableBox_MouseMove"
                            MouseLeftButtonUp="DraggableBox_MouseLeftButtonUp"
                            Cursor="SizeAll">
                        <TextBlock x:Name="TxtSubtitleRender" 
                                   Text="Phụ đề sẽ hiển thị tại đây" 
                                   Foreground="#FFFFFF" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="315" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>
                </Canvas>

                <!-- THANH ĐIỀU KHIỂN & TIMELINE NỔI -->
                <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="0,1,0,0" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Thanh Timeline tua video -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblTimeProgress" Text="00:00:00" Foreground="#858585" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Value="0" 
                                    PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                                    ValueChanged="TimelineSlider_ValueChanged"/>
                            <TextBlock x:Name="LblTotalTime" Grid.Column="2" Text="00:00:00" Foreground="#858585" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Nút điều hướng & Bật/Tắt nhanh Phụ đề + Giọng AI + Xuất Video -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="⏮ -5s" Width="50" Height="26" Background="#2D2D30" Foreground="White" BorderThickness="0" Margin="0,0,5,0" Click="BtnRewind_Click"/>
                            <Button x:Name="BtnPlay" Content="▶ Phát" Width="64" Height="26" Background="#007ACC" Foreground="White" BorderThickness="0" Margin="0,0,5,0" Click="BtnPlay_Click"/>
                            <Button x:Name="BtnPause" Content="⏸ Tạm dừng" Width="78" Height="26" Background="#3E3E42" Foreground="White" BorderThickness="0" Margin="0,0,5,0" Click="BtnPause_Click"/>
                            <Button x:Name="BtnStop" Content="⏹ Dừng" Width="58" Height="26" Background="#3E3E42" Foreground="White" BorderThickness="0" Margin="0,0,5,0" Click="BtnStop_Click"/>
                            <Button Content="+5s ⏭" Width="50" Height="26" Background="#2D2D30" Foreground="White" BorderThickness="0" Margin="0,0,12,0" Click="BtnForward_Click"/>

                            <CheckBox x:Name="ChkHideSubtitle" Content="🙈 Ẩn phụ đề" Foreground="#FFCC00" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ChkHideSubtitle_Changed" Unchecked="ChkHideSubtitle_Changed"/>
                            <CheckBox x:Name="ChkEnableVoiceover" Content="🔊 Lồng tiếng AI" IsChecked="True" Foreground="#4EC9B0" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Button x:Name="BtnQuickExport" Content="🎬 Xuất MP4" Padding="10,0" Height="26" Background="#16825D" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnExportVideo_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- CỘT PHẢI: TABS CHỨC NĂNG -->
            <TabControl Grid.Column="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0">

                <!-- TAB 1: TẢI VIDEO, XUẤT VIDEO & VÙNG CHE MỜ -->
                <TabItem Header="Tải &amp; Xuất">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DÁN LIÊN KẾT VIDEO" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="YouTube, TikTok, Bilibili (.tv &amp; .com), Douyin" Foreground="#858585" FontSize="11" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtVideoUrl" Height="28" Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="PbDownload" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                            <Button x:Name="BtnDownloadVideo" Content="⬇ Tải Video Ngay" Height="32" Background="#0E639C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnDownloadVideo_Click" Margin="0,0,0,12"/>

                            <TextBlock Text="CHỌN TỆP TỪ MÁY TÍNH" Foreground="#858585" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <Button Content="📁 Duyệt Video Có Sẵn..." Height="30" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="BtnOpenVideo_Click" Margin="0,0,0,14"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <!-- XUẤT VIDEO HOÀN CHỈNH (FFMPEG) -->
                            <TextBlock Text="XUẤT VIDEO HOÀN CHỈNH (HARDSUB + GIỌNG AI)" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Ghép cứng phụ đề (nếu không ẩn), vùng che mờ, Watermark và trộn âm thanh lồng tiếng AI thành file .mp4" Foreground="#858585" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="PbExport" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                            <Button x:Name="BtnExportVideo" Content="🎬 Xuất Video MP4 Hoàn Chỉnh..." Height="34" Background="#16825D" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnExportVideo_Click" Margin="0,0,0,14"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <!-- TÙY CHỈNH HỘP CHE MỜ -->
                            <TextBlock Text="VÙNG CHE MỜ (KHÔNG VIỀN VÀNG)" Foreground="#FFCC00" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <Button x:Name="BtnToggleBlur" Content="🎭 Bật / Tắt Vùng Che Mờ" Height="30" Background="#2D2D30" Foreground="#FFCC00" BorderBrush="#FFCC00" BorderThickness="1" Click="ToggleBlurBox_Click" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Chiều rộng:" Foreground="#CCCCCC" FontSize="12" Width="80"/>
                                <TextBlock x:Name="LblBlurWidth" Text="160 px" Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <Slider x:Name="SliderBlurWidth" Minimum="40" Maximum="500" Value="160" ValueChanged="SliderBlurSize_ValueChanged" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Chiều cao:" Foreground="#CCCCCC" FontSize="12" Width="80"/>
                                <TextBlock x:Name="LblBlurHeight" Text="100 px" Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <Slider x:Name="SliderBlurHeight" Minimum="40" Maximum="400" Value="100" ValueChanged="SliderBlurSize_ValueChanged" Margin="0,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: AI & DỊCH THUẬT -->
                <TabItem Header="AI &amp; Dịch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="MÔ HÌNH AI" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbAiModel" Height="28" Background="#1E1E1E" Margin="0,0,0,8">
                                <ComboBoxItem Content="Google Gemini 2.0" IsSelected="True"/>
                                <ComboBoxItem Content="OpenAI GPT-4o"/>
                                <ComboBoxItem Content="Anthropic Claude 3.5"/>
                                <ComboBoxItem Content="DeepSeek-V3"/>
                            </ComboBox>

                            <TextBlock Text="API Key:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="TxtApiKey" Height="28" Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,10"/>

                            <TextBlock Text="PROMPT CHUẨN RẠP + ĐÁNH DẤU NHẤN NHÁ GIỌNG AI" Foreground="#FFCC00" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Hỗ trợ thẻ [ngắt], [nhấn: từ], [cao], [trầm] (ẩn trên màn hình video nhưng giọng AI hiểu được)" Foreground="#858585" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Button Content="📋 Sao Chép Prompt Rạp Phim + Lồng Tiếng AI" Height="30" Background="#383838" Foreground="#DCDCDC" BorderBrush="#555" BorderThickness="1" Click="BtnCopyPrompt_Click" Margin="0,0,0,8"/>
                            <Button x:Name="BtnAutoAiSub" Content="✨ Tự Động Dịch Bằng API" Height="32" Background="#68217A" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAutoAiSub_Click" Margin="0,0,0,12"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,10"/>

                            <!-- Khung chỉnh sửa SRT trực tiếp (Real-time Sync) -->
                            <TextBlock Text="NỘI DUNG PHỤ ĐỀ (HIỂU CẢ KÝ HIỆU NHẤN NHÁ AI)" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSrtEditor" Height="150" Background="#1E1E1E" Foreground="#9CDCFE" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderBrush="#3F3F46" TextChanged="TxtSrtEditor_TextChanged" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⚡ Nạp Phụ Đề" Height="28" Background="#2D2D30" Foreground="#DCDCDC" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,6,0" Click="BtnApplySub_Click"/>
                                <Button Grid.Column="1" Content="🎙 Tạo Giọng Đọc Ngay" Padding="10,0" Height="28" Background="#0E639C" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnGenerateVoice_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: GIỌNG AI (TIKTOK / YOUTUBE NEURAL TTS) -->
                <TabItem Header="Giọng AI">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="CHỌN GIỌNG ĐỌC TIẾNG VIỆT (TIKTOK / YOUTUBE)" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbTtsVoice" Height="30" Margin="0,0,0,12">
                                <ComboBoxItem Content="🎬 Nam Minh - Nam Review Phim / TikTok (Trầm ấm)" IsSelected="True"/>
                                <ComboBoxItem Content="🌸 Hoài My - Nữ Kể Chuyện / YouTube (Truyền cảm)"/>
                                <ComboBoxItem Content="⚡ Nam Minh - Nam Tin Tức / Công Nghệ (Nhanh, dứt khoát)"/>
                                <ComboBoxItem Content="🎙 Hoài My - Nữ Podcast / Tâm Sự (Nhẹ nhàng, sâu lắng)"/>
                                <ComboBoxItem Content="🔥 ElevenLabs / OpenAI Neural (Dùng API Key riêng)"/>
                            </ComboBox>

                            <TextBlock Text="CHẾ ĐỘ ĐỌC PHỤ ĐỀ" Foreground="#FFCC00" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RbReadNatural" Content="1. Đọc Tự Nhiên (Nhấn nhá, cao thấp, ngắt nghỉ theo ngữ cảnh)" IsChecked="True" Foreground="#FFFFFF" FontSize="11.5" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RbReadNormal" Content="2. Đọc Bình Thường (Đều giọng, tốc độ &amp; cao độ ổn định)" Foreground="#CCCCCC" FontSize="11.5" Margin="0,0,0,12"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <TextBlock Text="ĐIỀU CHỈNH NHỊP ĐỌC &amp; ÂM LƯỢNG" Foreground="#858585" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Tốc độ đọc:" Foreground="#CCCCCC" FontSize="12" Width="110"/>
                                <TextBlock x:Name="LblTtsRate" Text="+5%" Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <Slider x:Name="SliderTtsRate" Minimum="-30" Maximum="50" Value="5" ValueChanged="SliderTtsParams_ValueChanged" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Cao độ (Pitch):" Foreground="#CCCCCC" FontSize="12" Width="110"/>
                                <TextBlock x:Name="LblTtsPitch" Text="+0 Hz" Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <Slider x:Name="SliderTtsPitch" Minimum="-20" Maximum="20" Value="0" ValueChanged="SliderTtsParams_ValueChanged" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Âm lượng video gốc khi AI đọc:" Foreground="#CCCCCC" FontSize="12" Width="185"/>
                                <TextBlock x:Name="LblVideoDucking" Text="25%" Foreground="#FFCC00" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <Slider x:Name="SliderVideoDucking" Minimum="0" Maximum="100" Value="25" ValueChanged="SliderTtsParams_ValueChanged" Margin="0,0,0,12"/>

                            <ProgressBar x:Name="PbTtsGen" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,8"/>

                            <Button x:Name="BtnGenerateVoice" Content="🎧 Tải &amp; Đồng Bộ Giọng Đọc Cho Toàn Bộ Phụ Đề" Height="34" Background="#0E639C" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnGenerateVoice_Click" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="▶ Nghe Thử Câu Đầu" Height="28" Background="#2D2D30" Foreground="#4EC9B0" BorderBrush="#4EC9B0" BorderThickness="1" Margin="0,0,4,0" Click="BtnPreviewVoice_Click"/>
                                <Button Grid.Column="1" Content="📂 Mở Thư Mục MP3" Height="28" Background="#2D2D30" Foreground="#DCDCDC" BorderBrush="#3F3F46" BorderThickness="1" Margin="4,0,0,0" Click="BtnOpenTtsFolder_Click"/>
                            </Grid>

                            <Separator Background="#3F3F46" Margin="0,0,0,10"/>

                            <TextBlock Text="MẸO KÝ HIỆU TRONG Ô PHỤ ĐỀ:" Foreground="#858585" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,4"/>
                            <TextBlock Text="• Chèn [ngắt] hoặc ... để giọng đọc dừng lấy hơi tự nhiên.&#x0a;• Chèn [nhấn: từ khóa] để AI nhấn mạnh trọng âm.&#x0a;• Chèn [cao] hoặc [trầm] ở đầu câu để đổi sắc thái.&#x0a;(Mọi thẻ [...] sẽ tự động tàng hình trên màn hình video!)" Foreground="#999999" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 4: KIỂU CHỮ & NỀN -->
                <TabItem Header="Kiểu Chữ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="ChkHideSubtitleTab" Content="🙈 Ẩn chữ phụ đề trên màn hình video (Chỉ nghe thuyết minh)" Foreground="#FFCC00" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,12" Checked="ChkHideSubtitle_Changed" Unchecked="ChkHideSubtitle_Changed"/>

                            <TextBlock Text="ĐỐI TƯỢNG TÙY CHỈNH" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbStyleTarget" Height="28" SelectionChanged="CmbStyleTarget_SelectionChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Phụ đề chính" IsSelected="True"/>
                                <ComboBoxItem Content="Credit người dịch"/>
                                <ComboBoxItem Content="Miễn trừ trách nhiệm"/>
                                <ComboBoxItem Content="Áp dụng tất cả"/>
                            </ComboBox>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <TextBlock Text="PHÔNG CHỮ &amp; MÀU CHỮ" Foreground="#858585" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbFont" Height="28" SelectionChanged="CmbFont_SelectionChanged" Margin="0,0,0,10">
                                <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Roboto"/>
                                <ComboBoxItem Content="Montserrat"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Consolas"/>
                            </ComboBox>

                            <TextBlock Text="Màu chữ:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbTextColor" Height="28" SelectionChanged="CmbTextColor_SelectionChanged" Margin="0,0,0,12">
                                <ComboBoxItem Content="Trắng (Mặc định)" IsSelected="True"/>
                                <ComboBoxItem Content="Vàng Rạp Phim (Cinema Gold)"/>
                                <ComboBoxItem Content="Xanh Lơ (Cyan)"/>
                                <ComboBoxItem Content="Xanh Lá (Neon Green)"/>
                                <ComboBoxItem Content="Hồng Phấn (Pastel Pink)"/>
                                <ComboBoxItem Content="Cam Sáng (Orange)"/>
                                <ComboBoxItem Content="Đỏ Tươi (Crimson Red)"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Cỡ chữ:" Foreground="#CCCCCC" FontSize="12" Width="60"/>
                                <TextBlock x:Name="LblFontSize" Text="26 px" Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <Slider x:Name="SliderFontSize" Minimum="10" Maximum="54" Value="26" ValueChanged="SliderFontSize_ValueChanged" Margin="0,0,0,14"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <TextBlock Text="NỀN KHUNG CHỮ" Foreground="#858585" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Độ mờ nền:" Foreground="#CCCCCC" FontSize="12" Width="80"/>
                                <TextBlock x:Name="LblBgOpacity" Text="50%" Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <Slider x:Name="SliderBgOpacity" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" ValueChanged="SliderBgOpacity_ValueChanged" Margin="0,0,0,14"/>

                            <TextBlock Text="Màu nền khung:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBgColor" Height="28" SelectionChanged="CmbBgColor_SelectionChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Đen (Mặc định)" IsSelected="True"/>
                                <ComboBoxItem Content="Xanh đen Visual Studio"/>
                                <ComboBoxItem Content="Xám tối"/>
                                <ComboBoxItem Content="Đỏ mờ"/>
                            </ComboBox>

                            <Button Content="🎯 Căn Giữa Khung Đang Chọn" Height="30" Background="#2D2D30" Foreground="#4EC9B0" BorderBrush="#3F3F46" BorderThickness="1" Click="BtnCenterSelectedTarget_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: BẢN QUYỀN -->
                <TabItem Header="Bản Quyền">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DẤU MỜ BẢN QUYỀN (WATERMARK)" Foreground="#4EC9B0" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtInputWatermark" Text="© Vietsub: Nguyễn Cường" Background="#1E1E1E" Foreground="White" Height="26" BorderBrush="#3F3F46" Padding="4,2" TextChanged="TxtInputWatermark_TextChanged" Margin="0,0,0,6"/>

                            <CheckBox x:Name="ChkFloatingWatermark" Content="Bật chế độ Watermark chạy tự do" Foreground="#FFCC00" FontSize="12" Margin="0,0,0,8" Checked="ChkFloatingWatermark_Checked" Unchecked="ChkFloatingWatermark_Unchecked"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Độ mờ:" Foreground="#999" FontSize="11" VerticalAlignment="Center" Width="45"/>
                                <Slider x:Name="SliderWatermarkOpacity" Minimum="0.1" Maximum="1.0" Value="0.5" Width="140" VerticalAlignment="Center" ValueChanged="SliderWatermarkOpacity_ValueChanged"/>
                            </StackPanel>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <TextBlock Text="CREDIT DỊCH GIẢ &amp; TÁC GIẢ GỐC" Foreground="#858585" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="Tên người dịch:" Foreground="#BBB" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtInputSubber" Text="Nguyễn Cường" Background="#1E1E1E" Foreground="White" Height="24" BorderBrush="#3F3F46" Padding="4,2" TextChanged="UpdateAttributionTexts" Margin="0,0,0,6"/>

                            <TextBlock Text="Tên kênh tác giả gốc:" Foreground="#BBB" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtInputAuthor" Text="Enigma" Background="#1E1E1E" Foreground="White" Height="24" BorderBrush="#3F3F46" Padding="4,2" TextChanged="UpdateAttributionTexts" Margin="0,0,0,6"/>

                            <TextBlock Text="Nội dung Credit (Tùy chỉnh trực tiếp):" Foreground="#BBB" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtCustomCredit" Background="#1E1E1E" Foreground="#9CDCFE" Height="38" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#3F3F46" Padding="4,2" TextChanged="TxtCustomCredit_TextChanged" Margin="0,0,0,6"/>

                            <TextBlock Text="Nội dung Miễn trừ trách nhiệm (Tùy chỉnh trực tiếp):" Foreground="#BBB" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtCustomDisclaimer" Background="#1E1E1E" Foreground="#9CDCFE" Height="48" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#3F3F46" Padding="4,2" TextChanged="TxtCustomDisclaimer_TextChanged" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Từ:" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox x:Name="InputCreditStart" Text="0" Width="35" Height="22" Background="#1E1E1E" Foreground="White" Margin="4,0,8,0" TextAlignment="Center"/>
                                <TextBlock Text="đến:" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox x:Name="InputCreditEnd" Text="5" Width="35" Height="22" Background="#1E1E1E" Foreground="White" Margin="4,0,0,0" TextAlignment="Center"/>
                                <TextBlock Text="giây" Foreground="#999" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkShowCredit" Content="Hiện Credit người dịch (0-5s)" IsChecked="True" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowDisclaimer" Content="Hiện Miễn trừ trách nhiệm (0-5s)" IsChecked="True" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,14"/>

                            <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                            <TextBlock Text="THỦY VÂN SỐ ẨN" Foreground="#CE9178" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔒 Cấy Mã Ẩn" Width="130" Height="28" Background="#2D2D30" Foreground="#4EC9B0" BorderBrush="#4EC9B0" BorderThickness="1" Click="BtnInjectStego_Click" Margin="0,0,8,0"/>
                                <Button Content="🔍 Soát Mã Ẩn" Width="110" Height="28" Background="#2D2D30" Foreground="#DCDCDC" BorderBrush="#3F3F46" BorderThickness="1" Click="BtnVerifyStego_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- THANH TRẠNG THÁI -->
        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="LblStatus" Text="Sẵn sàng." FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>